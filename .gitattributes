# Auto-detect text files, store LF in repo, and convert to CRLF on checkout
* text=auto eol=crlf

# Explicitly declare text files
*.cs text diff=csharp eol=crlf
*.cginc text eol=crlf
*.hlsl text eol=crlf
*.shader text eol=crlf
*.shadergraph text eol=crlf
*.compute text eol=crlf
*.asmdef text eol=crlf
*.asmref text eol=crlf
*.inputactions text eol=crlf
*.jslib text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.html text eol=crlf
*.svg text eol=crlf
*.ps1 text eol=crlf

# Unity YAML / text assets
*.meta text eol=crlf
*.unity text eol=crlf
*.prefab text eol=crlf
*.asset text eol=crlf
*.mat text eol=crlf
